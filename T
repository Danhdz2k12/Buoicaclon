-- Khai báo biến
local lp = game.Players.LocalPlayer
local count = 0
local autoChestEnabled = false

-- Danh sách khu vực
local areas = {
    "Colosseum", "Desert", "Fishmen", "Fountain",
    "Ice", "Jungle", "Magma", "MarineBase",
    "MarineStart", "MobBoss", "Pirate", "Prison",
    "Sky", "SkyArea1", "SkyArea2", "TeleportSpawn",
    "Town", "Windmill"
}

-- Hàm tạo GUI
local function createToggleGui()
    local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
    ScreenGui.Name = "AutoChestGui"

    local Button = Instance.new("TextButton", ScreenGui)
    Button.Size = UDim2.new(0, 160, 0, 40)
    Button.Position = UDim2.new(0, 10, 0, 100)
    Button.Text = "Bật Auto Chest"
    Button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Font = Enum.Font.SourceSansBold
    Button.TextSize = 20
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = true

    Button.MouseButton1Click:Connect(function()
        autoChestEnabled = not autoChestEnabled
        Button.Text = autoChestEnabled and "Tắt Auto Chest" or "Bật Auto Chest"
    end)
end

-- Di chuyển đến đảo
local function moveToArea(area)
    local areaPart = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild(area)
    if areaPart then
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = areaPart.CFrame + Vector3.new(0, 10, 0)
            task.wait(2)
        end
    end
end

-- Dịch chuyển đến rương
local function teleportToChest(area, index)
    local chestPath = workspace.Map and workspace.Map:FindFirstChild(area)
    if chestPath then
        local chests = chestPath:FindFirstChild("Chests")
        if chests then
            local targetChest = chests:GetChildren()[index]
            if targetChest and targetChest:IsA("BasePart") then
                local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = targetChest.CFrame
                end
            end
        end
    end
end

-- Reset nhân vật
local function resetCharacter()
    local character = lp.Character or lp.CharacterAdded:Wait()
    character:BreakJoints()
end

-- Vòng lặp chính
task.spawn(function()
    while true do
        if autoChestEnabled then
            for _, area in ipairs(areas) do
                if not autoChestEnabled then break end
                moveToArea(area)
                for index = 1, 18 do
                    if not autoChestEnabled then break end
                    teleportToChest(area, index)
                    count += 1
                    task.wait(0.1)
                    if count >= 1000 then
                        resetCharacter()
                        count = 0
                        task.wait(10)
                        break
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

-- Khởi tạo GUI
createToggleGui()
